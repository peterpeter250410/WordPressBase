# ============================================
# WordPress Core
# wp-admin/ wp-includes/ and root php files are tracked
# ============================================

# ============================================
# wp-content partial tracking
# ============================================
/wp-content/uploads/*
!/wp-content/uploads/.gitkeep

/wp-content/upgrade/
/wp-content/cache/
/wp-content/backups/
/wp-content/blogs.dir/

# Third-party plugins (track via docs/plugins.md)
/wp-content/plugins/*
!/wp-content/plugins/.gitkeep
# For custom plugins: git add -f wp-content/plugins/your-plugin

# Default themes (keep only custom themes)
/wp-content/themes/twenty*/

# ============================================
# Sensitive files
# ============================================
wp-config.php
.htaccess
*.sql
*.sql.gz
*.log
.env
.env.*

# ============================================
# OS and IDE
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ============================================
# BT Panel generated files
# ============================================
.user.ini
.well-known/

# IndexNow 密钥（服务器本地状态，不入库）
.indexnow-key
/[0-9a-f][0-9a-f]*.txt
